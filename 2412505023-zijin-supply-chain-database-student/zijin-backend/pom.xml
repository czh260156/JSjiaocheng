<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml 是 Maven 项目的配置文件。
    作用：定义项目名称、Java 版本、依赖包和打包方式。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Maven POM 模型版本，固定写 4.0.0。 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 父工程：统一管理 Spring Boot 依赖版本和插件版本。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.6</version>
        <relativePath/>
    </parent>

    <!-- 项目坐标：Maven 用 groupId + artifactId + version 唯一标识这个后端项目。 -->
    <groupId>com.zijin</groupId>
    <artifactId>zijin-backend</artifactId>
    <version>1.0.0</version>
    <name>zijin-backend</name>
    <description>Zijin supply chain database backend for database principle course.</description>

    <!-- Java 版本：Spring Boot 3 项目使用 Java 17。 -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- 项目依赖：这里声明后端需要的外部功能包。 -->
    <dependencies>
        <!-- Web 依赖：提供 REST 接口、Controller 和内嵌 Tomcat。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC 依赖：提供 DataSource 和 JdbcTemplate，用来操作数据库。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MySQL 驱动：让 Java 后端能通过 JDBC 连接 MySQL。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!-- 打包配置：使用 Spring Boot 插件把后端打包成可运行的 jar。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>